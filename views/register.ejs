<%- include('partials/head', { title: 'Register' }) %>
  <h1>Create an account</h1>

  <% errors.forEach(function (error) { %>
    <%# XSS PROTECTION: the EJS output tag escapes HTML, so a script tag is shown as plain text %>
    <p class="message error"><%= error %></p>
  <% }); %>

  <form method="post" action="/register" id="register-form">
    <label for="name">Name</label>
    <input type="text" id="name" name="name" maxlength="100" value="<%= name %>" required>

    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= email %>" required>

    <label for="password">Password (8 to 72 characters)</label>
    <input type="password" id="password" name="password" required>

    <label for="role">Role</label>
    <select id="role" name="role">
      <option value="user"  <%= role === 'user'  ? 'selected' : '' %>>User</option>
      <option value="admin" <%= role === 'admin' ? 'selected' : '' %>>Admin</option>
    </select>

    <button type="submit">Register</button>
  </form>

  <p class="link">Already have an account? <a href="/login">Log in</a></p>
<%- include('partials/foot') %>
